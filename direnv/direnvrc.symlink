#!/usr/bin/env bash

_DIRENVRC_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# This function is intended to be used as a direnv layout.
# It sets up a poetry environment for the current project.
layout_poetry() {
    # Deactivate any active virtual environment.
    if [[ -n "$VIRTUAL_ENV" ]]; then
        log_status "Deactivating active virtual environment: $VIRTUAL_ENV"
        unset POETRY_ACTIVE
        unset VIRTUAL_ENV
    fi

    log_status "Direnv: Setting up poetry environment"
    if [[ ! -f pyproject.toml ]]; then
        log_error 'No pyproject.toml found.'
        return 1
    fi

    # Determine desired Python version, in priority order:
    #   1. An explicit .python-version file always wins.
    #   2. Otherwise, ask resolve_python_version.py to find a version satisfying
    #      the project's pyproject.toml/poetry.lock constraint — first among
    #      versions already installed via pyenv (fast, no install prompt),
    #      then among versions pyenv could install (slower, will prompt below).
    #   3. If the constraint can't be determined or nothing satisfies it,
    #      fall back to whatever the newest pyenv-installable release is (the
    #      original behavior) so we always produce *some* answer.
    local desired_ver
    if [[ -f .python-version ]]; then
        desired_ver=$(cat .python-version)
    else
        local resolver="$_DIRENVRC_DIR/resolve_python_version.py"
        local installed installable chosen

        # Fast path: is there already a pyenv-installed version that satisfies
        # the constraint? This is what lets `direnv reload` reuse an existing
        # poetry environment instead of re-guessing a version each time.
        installed=$(pyenv versions --bare | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$')
        chosen=$(python3 "$resolver" --pyproject pyproject.toml --poetry-lock poetry.lock --candidates "$installed" 2>/dev/null)
        if [[ -n "$chosen" ]]; then
            desired_ver="$chosen"
            echo >&2 "No .python-version file; pyproject.toml's constraint is satisfied by already-installed Python $desired_ver"
        else
            # Nothing installed satisfies it — check what pyenv could install
            # instead, so a fresh/bootstrap project still lands on a version
            # compatible with its own constraint rather than "whatever's newest".
            installable=$(pyenv install -l | grep -E '^\s*[0-9][\.0-9]*$' | awk '{$1=$1};1')
            chosen=$(python3 "$resolver" --pyproject pyproject.toml --poetry-lock poetry.lock --candidates "$installable" 2>/dev/null)
            if [[ -n "$chosen" ]]; then
                desired_ver="$chosen"
                echo >&2 "No .python-version file; will install Python $desired_ver to satisfy pyproject.toml's constraint"
            else
                # Resolver couldn't find or parse a constraint at all (e.g. no
                # pyproject.toml/poetry.lock, or an unrecognized format).
                # Last resort: just take the newest release pyenv knows about.
                echo >&2 "Could not resolve a Python version satisfying pyproject.toml; defaulting to latest available"
                desired_ver=$(pyenv install -l | grep -E '^\s*3[\.0-9]*$' | sort --version-sort | tail -n 1 | awk '{$1=$1};1')
            fi
        fi
    fi
    echo >&2 "Desired version: $desired_ver"

    # Ensure the desired python version is installed via pyenv.
    if ! pyenv versions --bare | grep -q "^${desired_ver}$"; then
        echo >&2 "Python version $desired_ver is not installed."
        echo >&2 -n "Would you like to install it with pyenv? (y/n) "
        read -r answer
        if [[ "$answer" != "y" ]]; then
            log_error "Installation aborted by user."
            return 1
        fi
        if ! pyenv install "$desired_ver"; then
            log_error "pyenv failed to install Python $desired_ver."
            return 1
        fi
    fi

    # Get the full path to the python executable from the pyenv version.
    local python_exe
    python_exe="$(pyenv root)/versions/${desired_ver}/bin/python"

    # Tell poetry to use this python version.
    # This will create and/or switch to the correct virtualenv.
    log_status "Running 'poetry env use $python_exe'..."
    if ! poetry env use "$python_exe"; then
        log_error "poetry env use failed. Your pyenv/poetry setup might be broken."
        return 1
    fi

    # Get the path of the virtualenv that poetry is now using.
    local venv_path
    venv_path=$(poetry env info --path)
    if [[ ! -d "$venv_path" ]]; then
        log_error "Could not determine virtualenv path from poetry."
        return 1
    fi

    # Activate the virtualenv
    log_status "Activating virtualenv: $venv_path"
    export VIRTUAL_ENV="$venv_path"
    PATH_add "$VIRTUAL_ENV/bin"
    export POETRY_ACTIVE=1

    # Install dependencies if lock file is newer.
    local last_install_marker="$venv_path/direnv_last_install"
    if [[ poetry.lock -nt "$last_install_marker" ]]; then
        log_status "poetry.lock updated. Running 'poetry install'."
        if poetry install; then
            touch "$last_install_marker"
        else
            log_error "poetry install failed."
            return 1
        fi
    else
        log_status "Dependencies are up to date."
    fi

    poetry env info
    poetry check
}
# vim: ft=bash
