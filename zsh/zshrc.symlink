# Path to dotfiles source directory
DOTFILES="$(builtin cd "$(dirname "$(readlink ~/.zshrc)")" && git rev-parse --show-toplevel)"
export DOTFILES

source "${DOTFILES}/zsh/vars"
source "${DOTFILES}/zsh/aliases"
source "${DOTFILES}/zsh/zsh-features"
source "${DOTFILES}/zsh/3rd-party"
source "${DOTFILES}/zsh/path"
source "${DOTFILES}/zsh/local"
source "${DOTFILES}/zsh/ssh-agent"
source "${DOTFILES}/zsh/prompt"

# Change directory to dev
if ! { [ -n "$TMUX" ]; }; then
    [ -d "$HOME/dev" ] && cd "$HOME/dev" || return
fi

function precmd() {
    if [[ "${PWD:h}" == "$HOME/dev" ]]; then
        tmux rename-window -t"${TMUX_PANE}" "${PWD:t}"
    # Linked git worktree at ~/dev/<project>/<worktree>: its .git is a file
    # pointing at <repo>/.git/worktrees/<name> (submodules point at .git/modules)
    elif [[ "${PWD:h:h}" == "$HOME/dev" && -f "$PWD/.git" && "$(<$PWD/.git)" == "gitdir: "*/worktrees/* ]]; then
        tmux rename-window -t"${TMUX_PANE}" "${PWD:h:t}/${PWD:t}"
    fi
    prompt_precmd
}

# vim: ft=zsh
